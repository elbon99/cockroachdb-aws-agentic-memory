# Required for submission mode. Omit only for the clearly labeled local demo store.
DATABASE_URL=postgresql://contextseal:<password>@<host>:26257/contextseal?sslmode=verify-full
CONTEXTSEAL_AUTO_SEED=false
CONTEXTSEAL_TRACKED_REPO=C:\path\to\tracked\repository

# deterministic | bedrock
AGENT_ENGINE=deterministic

# Bedrock fixed-region cache demonstration.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_CACHE_TTL=5m

# CockroachDB Cloud MCP configuration used by the auditor agent/client.
COCKROACH_MCP_URL=https://cockroachlabs.cloud/mcp
COCKROACH_CLUSTER_ID=

# Optional deployment metadata surfaced by /api/health.
APP_ENVIRONMENT=development
